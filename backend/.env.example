# ─── API Settings ───────────────────────────────────────────────────────────
DEBUG=false
APP_NAME="Financial Bot API"

# ─── RAG / Embedding Settings ───────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2
MAX_RESULTS=3

# ─── File Settings ──────────────────────────────────────────────────────────
DATA_FILE=sample_qa.json

# ─── Gemini LLM Settings ────────────────────────────────────────────────────
# Get your free API key at: https://aistudio.google.com/app/apikey
# Leave empty or as-is to run in fallback mode (no LLM, uses best-matched Q&A)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TEMPERATURE=0.2

# ─── Cost Optimisation ───────────────────────────────────────────────────────
# Compress conversation history only after this many messages (default: 10)
# Lower = more Flash calls for summarisation; higher = larger prompts per turn.
SUMMARY_THRESHOLD=10
# Use Flash instead of Pro when RAG returns full coverage (default: true)
# Flash costs ~47x less than Pro; safe to use when the context fully covers the answer.
USE_FLASH_FOR_GROUNDED_ANSWERS=true
# Max cached responses kept in memory (default: 256)
RESPONSE_CACHE_SIZE=256

# ─── Cognitive Memory System ─────────────────────────────────────────────────
# Number of past episodes retrieved per query for long-term context (default: 3)
MEMORY_TOP_K=3
# Max stored episodes per user before oldest is evicted (default: 100)
MEMORY_MAX_EPISODES_PER_USER=100

# ─── Live Token Telemetry (USD per 1M tokens) ───────────────────────────────
FLASH_INPUT_USD_PER_MILLION=0.075
FLASH_OUTPUT_USD_PER_MILLION=0.30
PRO_INPUT_USD_PER_MILLION=1.25
PRO_OUTPUT_USD_PER_MILLION=5.00

# ─── Retrieval grading / web fallback ───────────────────────────────────────
MAX_QUERY_REWRITES=1
WEB_SEARCH_MAX_RESULTS=5
# Optional. If unset, DuckDuckGo is used when FAISS cannot answer.
TAVILY_API_KEY=
